# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://alphabet_user:your_password@localhost:5432/alphabet_dev
REDIS_URL=redis://localhost:6379/0

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=REPLACE_WITH_256_BIT_RANDOM_STRING
JWT_ALGORITHM=HS256

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
DOCUMENT_ENCRYPTION_KEY=REPLACE_WITH_SECOND_FERNET_KEY

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Alphabet
BASE_URL=http://localhost:8000
ENVIRONMENT=development       # development | production
DEBUG=true

# ─── M-Pesa (Safaricom Daraja) ────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_daraja_passkey
MPESA_ENVIRONMENT=sandbox     # sandbox | production
MPESA_CALLBACK_TOKEN=generate_a_long_random_string

# ─── Flutterwave ─────────────────────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_key
FLUTTERWAVE_SECRET_HASH=same_value_as_flutterwave_dashboard_secret_hash

# ─── Africa's Talking (SMS / OTP) ────────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=ALPHABET

# ─── Firebase (Push Notifications) ───────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# ─── AWS (Document Storage) ──────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=af-south-1
DOCUMENTS_BUCKET=alphabet-courier-docs

# ─── Google Maps ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
